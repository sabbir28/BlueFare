<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ MultiMic Client"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Status:"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Name:"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Phone"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Target:"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textServerAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.20:45454"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Microphone State Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Microphone State:"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textMicStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOPPED"
                android:textColor="#888888"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textActiveIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 RECORDING ACTIVE"
                android:textColor="@color/active_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Audio Level:"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressAudioLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- Control Buttons -->
        <Button
            android:id="@+id/btnScanConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Scan / Connect Server"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStartMic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="START MICROPHONE"
            android:backgroundTint="#22C55E"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStopMic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="STOP MICROPHONE"
            android:backgroundTint="@color/active_red"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Settings"
            android:backgroundTint="#475569"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
